<!-- =========================================================
     4. 21ST.DEV INTERACTIVE BENTO PORTFOLIO GALLERY (#75)
     ========================================================= -->
<section class="arch-section arch-portfolio-section reveal">
  <div class="container">
    <div class="arch-center-head">
      <span class="arch-eyebrow">Portfolio Highlights</span>
      <h2>Explore our signature works</h2>
    </div>

    <div class="t21-bento-gallery">
      <%
        const combinedItems = featuredVideos.map(v => ({...v, isVideo: true})).concat(featuredPhotos.map(p => ({...p, isVideo: false})));
        const fallbackWorks = [
          { isVideo: false, file_path: INDIAN_IMG_1, title: 'Ananya & Kabir — Udaipur Palace', category: 'Royal Wedding' },
          { isVideo: false, file_path: INDIAN_IMG_2, title: 'Riya — Bridal Couture Portraits', category: 'Bridal Stills' },
          { isVideo: false, file_path: INDIAN_IMG_3, title: 'Rohan & Meera — Haldi Morning', category: 'Haldi & Mehndi' },
          { isVideo: false, file_path: INDIAN_IMG_4, title: 'Dev & Sonia — Sacred Pheras', category: 'Wedding Rituals' },
          { isVideo: false, file_path: INDIAN_IMG_5, title: 'Vikram & Tanya — Sunset Vows', category: 'Pre-Wedding' },
          { isVideo: false, file_path: INDIAN_IMG_6, title: 'Aarav & Kriti — Sangeet Night', category: 'Grand Sangeet' }
        ];
        const gridItems = combinedItems.length > 0 ? combinedItems.slice(0, 6) : fallbackWorks;
        const bentoSpans = ['t21-span-hero', 't21-span-tall', 't21-span-std', 't21-span-std', 't21-span-wide', 't21-span-std'];

        gridItems.forEach((item, idx) => {
          const rawThumb = item.isVideo ? (item.thumbnail || getYtThumb(item.youtube_url)) : item.file_path;
          const thumbUrl = sanitizeIndianBanner(rawThumb, fallbackWorks[idx % fallbackWorks.length].file_path);
          const stackArr = (!item.isVideo && item.images && item.images.length) ? item.images : [thumbUrl];
      %>
        <div class="arch-work-card <%= item.isVideo ? 'video-card-trigger' : 'photo-item-trigger' %>"
             <%= item.isVideo ? `data-youtube-url="${item.youtube_url || ''}" data-video-url="${item.file_path || ''}"` : `data-src="${thumbUrl}" data-title="${item.title || 'Taj Studio Capture'}"` %>
             <% if (!item.isVideo) { %>data-stack='<%= JSON.stringify(stackArr) %>'<% } %>>
          <% if (item.isVideo && !rawThumb && item.file_path) { %>
            <video src="<%= item.file_path %>#t=0.1" muted loop playsinline preload="metadata" class="carousel-video-preview"></video>
          <% } else { %>
            <img src="<%= thumbUrl %>" alt="<%= item.title || 'Taj Studio Work' %>" loading="lazy" onerror="if(this.src.includes('maxresdefault')){this.src=this.src.replace('maxresdefault','hqdefault');}else{this.src='<%= INDIAN_IMG_1 %>';}">
          <% } %>
          <% if (item.isVideo) { %>
            <div class="arch-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          <% } else { %>
            <% if (stackArr.length > 1) { %>
              <span class="stack-count-badge">&#10064; <%= stackArr.length %> Photos</span>
            <% } %>
            <div class="arch-work-info">
              <span><%= item.category || 'Signature' %> • <%= stackArr.length > 1 ? stackArr.length + ' Photos' : 'Stills' %></span>
              <h3><%= item.title || 'Taj Studio Story' %></h3>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>

    <div style="text-align: center; margin-top: 2.25rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/videos" class="arch-btn-gold t21-magnetic">View All Films</a>
      <a href="/photos" class="arch-btn-pill-outline t21-magnetic">View Photo Gallery</a>
    </div>
  </div>
</section>

