<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
  function getYtThumb(url) {
    if (!url) return '';
    const m = String(url).match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([A-Za-z0-9_-]{11})/);
    return m ? `https://img.youtube.com/vi/${m[1]}/hqdefault.jpg` : '';
  }

  // Real Taj Studio Indian Wedding thumbnails & banners (100% Indian wedding imagery)
  const INDIAN_IMG_1 = '/images/hero-royal-wedding.jpg';
  const INDIAN_IMG_2 = 'https://img.youtube.com/vi/Ovgg7H1Lvyg/maxresdefault.jpg';
  const INDIAN_IMG_3 = 'https://img.youtube.com/vi/-E66JvzL6aI/maxresdefault.jpg';
  const INDIAN_IMG_4 = 'https://img.youtube.com/vi/GjAamVr8RQM/maxresdefault.jpg';
  const INDIAN_IMG_5 = 'https://img.youtube.com/vi/AivhXO30EHo/maxresdefault.jpg';
  const INDIAN_IMG_6 = 'https://img.youtube.com/vi/-nnqPb-KagE/maxresdefault.jpg';

  function sanitizeIndianBanner(url, fallback) {
    if (!url) return fallback;
    if (
      url.includes('1511285560929') ||
      url.includes('1492684223066') ||
      url.includes('1515934751635') ||
      url.includes('1610030469983') ||
      url.includes('1595981267035') ||
      url.includes('1583939003579')
    ) {
      return fallback;
    }
    return url;
  }
%>

<!-- =========================================================
     1. FULL-BLEED ARCHITECTURAL HERO SLIDER
     ========================================================= -->
<header class="hero-slider-section arch-hero" data-autoplay-duration="<%= settings.hero_duration %>">
  <div class="hero-slides-container">
    <% if (heroSlides.length === 0) { %>
      <div class="hero-slide active" style="background-image: url('<%= INDIAN_IMG_1 %>');">
        <div class="hero-overlay arch-hero-overlay"></div>
        <div class="hero-content container">
          <span class="arch-eyebrow">Luxury Indian Wedding Cinema &amp; Photography</span>
          <h1 class="arch-hero-title">
            <span class="word">Crafting</span>
            <span class="word">Royal</span>
            <span class="word">Wedding</span>
            <br>
            <span class="word">Heirlooms</span>
          </h1>
          <div class="hero-btns">
            <a href="/contact" class="arch-btn-pill-light t21-magnetic">Book a Consultation</a>
            <a href="/videos" class="arch-btn-pill-outline t21-magnetic">Watch Films</a>
          </div>
        </div>
      </div>
    <% } else { %>
      <%
        const slideFallbacks = [INDIAN_IMG_1, INDIAN_IMG_2, INDIAN_IMG_3];
        heroSlides.forEach((slide, index) => {
          const bgImg = sanitizeIndianBanner(slide.image_path, slideFallbacks[index % slideFallbacks.length]);
      %>
        <div class="hero-slide <%= index === 0 ? 'active' : '' %>" style="background-image: url('<%= bgImg %>');">
          <div class="hero-overlay arch-hero-overlay"></div>
          <div class="hero-content container">
            <span class="arch-eyebrow"><%= slide.subtitle || 'Luxury Indian Wedding Film & Photography' %></span>
            <h1 class="arch-hero-title">
              <% const words = (slide.title || 'Crafting Royal Wedding Heirlooms').split(' '); %>
              <% words.forEach(word => { %>
                <span class="word"><%= word %></span>
              <% }) %>
            </h1>
            <div class="hero-btns">
              <a href="/contact" class="arch-btn-pill-light t21-magnetic">Book a Consultation</a>
              <a href="/videos" class="arch-btn-pill-outline t21-magnetic">Watch Films</a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <% if (heroSlides.length > 1) { %>
    <div class="hero-controls">
      <button class="hero-ctrl-btn prev" aria-label="Previous Slide">&lsaquo;</button>
      <button class="hero-ctrl-btn next" aria-label="Next Slide">&rsaquo;</button>
    </div>
    <div class="hero-dots">
      <% heroSlides.forEach((_, index) => { %>
        <button class="hero-dot <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>"></button>
      <% }) %>
    </div>
  <% } %>
</header>

